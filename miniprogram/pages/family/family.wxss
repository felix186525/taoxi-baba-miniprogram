.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 18rpx 0 24rpx;
  padding: 26rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #f7c948;
  color: #2c2c2c;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 92rpx;
  text-align: center;
}

.title {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.card {
  margin-bottom: 18rpx;
  padding: 26rpx;
}

.card-label {
  margin-bottom: 12rpx;
  color: #7d7566;
  font-size: 24rpx;
}

.card-value {
  font-size: 32rpx;
  font-weight: 800;
}

.family-id {
  word-break: break-all;
  font-size: 26rpx;
}

.copy {
  margin-top: 20rpx;
}

.join-row {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 14rpx;
}

.join-input {
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.join-button,
.approve-button,
.reject-button {
  height: 72rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.join-button,
.approve-button {
  background: #1f8a70;
}

.reject-button {
  background: #d6533c;
}

.pending-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(44, 44, 44, 0.06);
}

.pending-row:last-child {
  border-bottom: 0;
}

.pending-openid {
  word-break: break-all;
  color: #2c2c2c;
  font-size: 24rpx;
}

.pending-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.tips {
  margin-top: 28rpx;
  padding: 26rpx;
}

.tips-title {
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.tips-text {
  color: #7d7566;
  font-size: 26rpx;
  line-height: 1.7;
}
