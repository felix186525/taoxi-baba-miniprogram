.family-hero {
  min-height: 220rpx;
}

.avatar {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
}

.card {
  box-sizing: border-box;
  margin-bottom: 18rpx;
  padding: 28rpx;
}

.family-name-card {
  display: grid;
  align-items: center;
  grid-template-columns: minmax(0, 1fr) auto;
  column-gap: 18rpx;
}

.stack-card {
  display: block;
}

.card-main {
  min-width: 0;
}

.card-main.full {
  width: 100%;
}

.card-label {
  margin-bottom: 12rpx;
  color: #7d8894;
  font-size: 24rpx;
  font-weight: 700;
}

.card-value {
  max-width: 100%;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-pill {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 138, 112, 0.1);
  color: #1f8a70;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.family-id {
  display: block;
  max-width: 100%;
  overflow: hidden;
  word-break: break-all;
  font-size: 26rpx;
  line-height: 1.45;
}

.copy {
  margin-top: 20rpx;
  width: 100%;
}

.join-row {
  display: grid;
  width: 100%;
  align-items: center;
  grid-template-columns: minmax(0, 1fr) 144rpx;
  gap: 14rpx;
}

.join-input {
  min-width: 0;
  font-size: 26rpx;
}

.join-button,
.approve-button,
.reject-button {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin: 0;
  min-width: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.join-button,
.approve-button {
  background: linear-gradient(135deg, #1f8a70, #23a887);
}

.reject-button {
  background: linear-gradient(135deg, #d6533c, #ff8a65);
}

.pending-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(23, 33, 43, 0.06);
}

.pending-row:last-child {
  border-bottom: 0;
}

.pending-openid {
  word-break: break-all;
  color: #17212b;
  font-size: 24rpx;
  line-height: 1.45;
}

.pending-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}
