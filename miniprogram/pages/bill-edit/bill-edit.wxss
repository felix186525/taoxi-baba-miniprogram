.edit-hero {
  min-height: 220rpx;
}

.type-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 10rpx;
  margin: 0 0 22rpx;
}

.toggle-item {
  height: 78rpx;
  border-radius: 18rpx;
  color: #7d8894;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 78rpx;
  text-align: center;
}

.toggle-item.active {
  color: #ffffff;
}

.toggle-item.expense {
  background: #d6533c;
}

.toggle-item.income {
  background: #1f8a70;
}

.form {
  padding: 6rpx 28rpx;
}

.field {
  padding: 30rpx 0;
  border-bottom: 2rpx solid rgba(23, 33, 43, 0.06);
}

.field:last-child {
  border-bottom: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #7d8894;
  font-size: 26rpx;
  font-weight: 700;
}

.row .field-label {
  margin-bottom: 0;
}

.amount-input {
  height: 96rpx;
  color: #17212b;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 96rpx;
}

.note-input {
  height: 76rpx;
  color: #17212b;
  font-size: 30rpx;
  line-height: 76rpx;
}

.picker-value {
  color: #17212b;
  font-size: 30rpx;
  font-weight: 900;
}

.save {
  margin-top: 32rpx;
}

.delete-button {
  margin-top: 18rpx;
}
