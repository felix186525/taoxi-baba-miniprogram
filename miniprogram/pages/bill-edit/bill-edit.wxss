.type-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 10rpx;
  margin: 18rpx 0 24rpx;
}

.toggle-item {
  height: 72rpx;
  border-radius: 12rpx;
  color: #7d7566;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.toggle-item.active {
  color: #ffffff;
}

.toggle-item.expense {
  background: #d6533c;
}

.toggle-item.income {
  background: #1f8a70;
}

.form {
  padding: 10rpx 28rpx;
}

.field {
  padding: 28rpx 0;
  border-bottom: 2rpx solid rgba(44, 44, 44, 0.06);
}

.field:last-child {
  border-bottom: 0;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #7d7566;
  font-size: 26rpx;
}

.row .field-label {
  margin-bottom: 0;
}

.amount-input {
  height: 88rpx;
  font-size: 56rpx;
  font-weight: 800;
}

.note-input {
  height: 64rpx;
  font-size: 30rpx;
}

.picker-value {
  color: #2c2c2c;
  font-size: 30rpx;
  font-weight: 700;
}

.save {
  margin-top: 32rpx;
}

.delete-button {
  height: 76rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #d6533c;
  font-size: 28rpx;
  line-height: 76rpx;
}
