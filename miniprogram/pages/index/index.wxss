.home-hero {
  padding-bottom: 30rpx;
}

.hero-total {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
}

.hero-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-amount {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  padding: 30rpx 10rpx;
}

.summary-item {
  min-width: 0;
  text-align: center;
}

.label {
  display: block;
  color: #7d8894;
  font-size: 22rpx;
  font-weight: 700;
}

.expense,
.income,
.balance {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expense {
  color: #d6533c;
}

.income {
  color: #1f8a70;
}

.balance {
  color: #2c2c2c;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 24rpx 0 32rpx;
}

.empty {
  padding: 56rpx 24rpx;
  color: #7d8894;
  text-align: center;
  font-size: 28rpx;
}

.bill {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.bill-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 76rpx;
  text-align: center;
}

.bill-icon.expense {
  background: linear-gradient(135deg, #d6533c, #ff8a65);
}

.bill-icon.income {
  background: linear-gradient(135deg, #1f8a70, #2ec4a6);
}

.bill-left {
  min-width: 0;
  flex: 1;
}

.category {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.3;
}

.bill-right {
  flex-shrink: 0;
  max-width: 240rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-right.expense {
  color: #d6533c;
}

.bill-right.income {
  color: #1f8a70;
}
