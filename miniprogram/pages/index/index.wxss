.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 18rpx 0 28rpx;
}

.eyebrow {
  color: #1f8a70;
  font-size: 24rpx;
  font-weight: 600;
}

.title {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 800;
}

.month {
  color: #7d7566;
  font-size: 26rpx;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 28rpx 18rpx;
}

.summary-item {
  text-align: center;
}

.label {
  display: block;
  color: #7d7566;
  font-size: 24rpx;
}

.expense,
.income,
.balance {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.expense {
  color: #d6533c;
}

.income {
  color: #1f8a70;
}

.balance {
  color: #2c2c2c;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 28rpx 0 32rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty {
  padding: 48rpx 24rpx;
  color: #7d7566;
  text-align: center;
}

.bill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.category {
  font-size: 30rpx;
  font-weight: 700;
}

.note {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.bill-right {
  font-size: 32rpx;
  font-weight: 800;
}

.bill-right.expense {
  color: #d6533c;
}

.bill-right.income {
  color: #1f8a70;
}
