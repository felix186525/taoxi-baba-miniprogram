.header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 18rpx 0 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 28rpx 18rpx;
  text-align: center;
}

.label {
  display: block;
  color: #7d7566;
  font-size: 24rpx;
}

.value {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.expense {
  color: #d6533c;
}

.income {
  color: #1f8a70;
}

.section-title {
  margin: 34rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.budget {
  margin-top: 20rpx;
  padding: 26rpx;
}

.budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.budget-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.budget-percent {
  color: #1f8a70;
  font-size: 34rpx;
  font-weight: 800;
}

.progress {
  height: 18rpx;
  margin: 24rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(31, 138, 112, 0.12);
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #1f8a70;
}

.progress-inner.over {
  background: #d6533c;
}

.budget-form {
  display: grid;
  grid-template-columns: 1fr 140rpx;
  gap: 14rpx;
}

.budget-input {
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.budget-button {
  height: 72rpx;
  border-radius: 12rpx;
  background: #1f8a70;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.empty {
  padding: 48rpx 24rpx;
  color: #7d7566;
  text-align: center;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.category-name {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.category-amount {
  color: #d6533c;
  font-size: 32rpx;
  font-weight: 800;
}
