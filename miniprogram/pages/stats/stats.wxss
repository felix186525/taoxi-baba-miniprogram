.stats-hero {
  padding-bottom: 30rpx;
}

.hero-total {
  position: relative;
  z-index: 1;
  margin-top: 34rpx;
}

.hero-label {
  display: block;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.hero-amount {
  display: block;
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  box-sizing: border-box;
  padding: 30rpx 14rpx;
  text-align: center;
}

.summary-item {
  min-width: 0;
  box-sizing: border-box;
  padding: 0 4rpx;
}

.label {
  display: block;
  color: #7d8894;
  font-size: 22rpx;
  font-weight: 700;
}

.value {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expense {
  color: #d6533c;
}

.income {
  color: #1f8a70;
}

.budget {
  margin-top: 20rpx;
  padding: 28rpx;
}

.budget-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.budget-copy {
  min-width: 0;
  flex: 1;
}

.budget-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.budget-percent {
  flex-shrink: 0;
  max-width: 150rpx;
  min-width: 90rpx;
  overflow: hidden;
  color: #1f8a70;
  font-size: 34rpx;
  font-weight: 900;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress {
  height: 18rpx;
  margin: 24rpx 0;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(31, 138, 112, 0.12);
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #1f8a70;
}

.progress-inner.over {
  background: #d6533c;
}

.budget-form {
  display: grid;
  align-items: center;
  grid-template-columns: minmax(0, 1fr) 144rpx;
  gap: 14rpx;
  width: 100%;
}

.budget-input {
  min-width: 0;
  font-size: 28rpx;
}

.budget-button {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin: 0;
  min-width: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1f8a70, #23a887);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 48rpx 24rpx;
  color: #7d7566;
  text-align: center;
}

.category-row {
  display: grid;
  grid-template-columns: 22rpx minmax(0, 1fr) auto;
  align-items: center;
  column-gap: 18rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.category-dot {
  width: 22rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #d6533c, #f2c94c);
}

.category-copy {
  min-width: 0;
}

.category-name {
  margin-bottom: 8rpx;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-amount {
  min-width: 0;
  max-width: 220rpx;
  overflow: hidden;
  color: #d6533c;
  font-size: 32rpx;
  font-weight: 900;
  text-align: right;
}

.category-amount text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
