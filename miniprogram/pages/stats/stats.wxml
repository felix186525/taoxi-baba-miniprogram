<view class="page">
  <view class="hero-panel stats-hero">
    <view class="hero-top">
      <view>
        <text class="eyebrow">数据看板</text>
        <view class="page-title">本月统计</view>
        <view class="page-subtitle">{{month}}</view>
      </view>
      <view class="hero-badge">{{budget.percent}}%</view>
    </view>
    <view class="hero-total">
      <text class="hero-label">本月支出</text>
      <text class="hero-amount">¥{{summary.expense}}</text>
    </view>
  </view>

  <view class="summary panel">
    <view class="summary-item">
      <text class="label">支出</text>
      <text class="value expense">¥{{summary.expense}}</text>
    </view>
    <view class="summary-item">
      <text class="label">收入</text>
      <text class="value income">¥{{summary.income}}</text>
    </view>
    <view class="summary-item">
      <text class="label">结余</text>
      <text class="value">¥{{summary.balance}}</text>
    </view>
  </view>

  <view class="budget panel">
    <view class="budget-head">
      <view class="budget-copy">
        <view class="budget-title">月度预算</view>
        <view class="muted">{{budgetTip}}</view>
      </view>
      <view class="budget-percent">{{budget.percent}}%</view>
    </view>
    <view class="progress">
      <view class="progress-inner {{budget.isOver ? 'over' : ''}}" style="width: {{budgetProgress}}%;"></view>
    </view>
    <view class="budget-form">
      <input class="budget-input input-surface" type="digit" placeholder="输入预算金额" value="{{budgetInput}}" bindinput="onBudgetInput" />
      <button class="budget-button" bindtap="saveBudget">保存</button>
    </view>
  </view>

  <view class="section-title">分类支出</view>
  <view wx:if="{{categories.length === 0}}" class="empty panel">本月还没有支出记录</view>
  <view wx:else class="category-list">
    <view wx:for="{{categories}}" wx:key="category" class="category-row panel">
      <view class="category-dot"></view>
      <view class="category-copy">
        <view class="category-name">{{item.category}}</view>
        <view class="muted">{{item.count}} 笔</view>
      </view>
      <view class="category-amount">
        <text>¥{{item.amount}}</text>
      </view>
    </view>
  </view>
</view>
