page {
  min-height: 100vh;
  background: #f7f0df;
  color: #2c2c2c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.panel {
  background: #fffaf0;
  border: 2rpx solid rgba(44, 44, 44, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(78, 59, 24, 0.06);
}

.primary-button {
  height: 88rpx;
  border-radius: 14rpx;
  background: #1f8a70;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.ghost-button {
  height: 76rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1f8a70;
  border: 2rpx solid rgba(31, 138, 112, 0.2);
  font-size: 28rpx;
  line-height: 76rpx;
}

.muted {
  color: #7d7566;
}
