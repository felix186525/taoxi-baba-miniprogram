page {
  min-height: 100vh;
  background: #eef2f6;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 40rpx;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  min-height: 260rpx;
  box-sizing: border-box;
  margin: 4rpx 0 24rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #12313a 0%, #1f8a70 58%, #f2c94c 150%);
  color: #ffffff;
  box-shadow: 0 24rpx 56rpx rgba(18, 49, 58, 0.22);
}

.hero-panel::after {
  content: "";
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 60rpx;
  background: rgba(255, 255, 255, 0.16);
  transform: rotate(18deg);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-top > view:first-child {
  min-width: 0;
  flex: 1;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 16rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
}

.page-subtitle {
  margin-top: 10rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-badge {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  min-width: 122rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #17212b;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.panel {
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(23, 33, 43, 0.06);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 38rpx rgba(23, 33, 43, 0.08);
}

.primary-button {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1f8a70, #23a887);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 16rpx 30rpx rgba(31, 138, 112, 0.22);
}

.ghost-button {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 18rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  color: #1f8a70;
  border: 2rpx solid rgba(31, 138, 112, 0.2);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.danger-button {
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(214, 83, 60, 0.1);
  color: #d6533c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.muted {
  color: #7d8894;
}

.input-surface {
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #f5f7fa;
  color: #17212b;
  font-size: 28rpx;
}
